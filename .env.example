# ==============================================================================
# OPRO 环境变量配置文件模板 (复制为 .env 使用)
# ==============================================================================

# 1. OpenAI 兼容 API 基础端点 (Base URL)
# 针对阿里云百炼 / 通义千问 (DashScope) 兼容模式端点：
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# 2. API Key (必填，请替换为您的实际 API Key)
OPENAI_API_KEY=your_api_key_here

# 3. 实验模型名称配置
# 可选模型如: qwen3.8-max-0902 / deepseek-v4.1-flash-1017
OPTIMIZER_MODEL=qwen3.8-max-0902
SCORER_MODEL=qwen3.8-max-0902

# 4. 思考模式开关 (Thinking / Reasoning Mode)
# 通义千问 / DashScope 兼容规范：
# - false: 关闭深度思考 (直接输出答案，不输出 reasoning_content，适合 OPRO 优化和评分，低延迟且节省 token)
# - true: 开启深度思考 (生成 reasoning_content 推理过程)
ENABLE_THINKING=false

# 5. 可选配置 (若使用原生 Google PaLM API)
PALM_API_KEY=
